<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for LocalMind's SKU / part-number row lookup. RowLookup.cs has no Windows dependencies, so this is a plain console app:
       Run with: dotnet run (from this folder). The exit code is the number of failed checks. Synthetic data only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\apps\LocalMindApp\RowLookup.cs" Link="RowLookup.cs" />
  </ItemGroup>
</Project>
